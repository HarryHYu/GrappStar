// GrappStar whole-system electrical diagram. Render: dot -Tsvg / -Tpng (make_guide.py does it).
// Bold lines = battery power, plain = low-voltage power and USB, dashed = signal, dotted = radio.
// GPIO numbers: brace PIN_ placeholders are filled from firmware/base/grappstar_base/pins.h by make_guide.py.
digraph G {
  graph [rankdir=TB, fontname="Liberation Sans", fontsize=11, nodesep=0.25, ranksep=0.55, splines=true, newrank=true];
  node  [shape=box, fontname="Liberation Sans", fontsize=10, color=black, fontcolor=black];
  edge  [fontname="Liberation Sans", fontsize=8, color=black, fontcolor=black, arrowsize=0.6];

  subgraph cluster_power {
    label="Rover power"; style=solid;
    lipo  [label="3S LiPo 5200 mAh\n9.9 to 12.6 V\nXT60"];
    ysplit[label="XT60 Y harness\n(spare XT60s, 14 AWG)"];
    f20   [label="Lead #2\n20 A fuse"];
    f10   [label="Lead #1\n10 A fuse"];
  }

  subgraph cluster_bay {
    label="Base electronics bay"; style=solid;
    bts   [label="BTS7960\nB+ B- | M+ M-\nRPWM LPWM R_EN L_EN IS VCC GND"];
    buck  [label="MP1584 #2\nset 9.0 V"];
    drv   [label="DRV8833 #3\nVM 9 V (max 10.8)\nAIN1 AIN2 (SLP not wired)"];
    esp   [label="ESP32-S3 DevKitC-1-N8\nUSB from Jetson\nGPIO: see firmware/base/WIRING.md", shape=box, style=bold];
    div   [label="Battery divider\n100 k / 22 k"];
    hx    [label="HX711 (optional)\n+ 100 kg load cell", style=dashed];
  }

  subgraph cluster_mech {
    label="Base mechanism"; style=solid;
    wiper [label="12 V wiper motor\n(2 wires)"];
    n20   [label="Selector drum N20\n(worm, self-locking)"];
    as5600[label="AS5600 (STEMMA QT)\nmain shaft end, 0x36"];
    sw    [label="Printed contacts (M3 screw on M3 nut)\nSW_DRUM_A/B/C, SW_DOG_L/R, SW_N20, SW_INDEX,\nSW_HOME, SW_GAP, SW_RAIL_LOW, SW_SEATED, SW_ARM"];
  }

  subgraph cluster_jetson {
    label="Jetson and video"; style=solid;
    jet   [label="Jetson Orin Nano Super\nDC jack 5.5 x 2.5", style=bold];
    rc832 [label="RC832 receiver\n5.8 GHz"];
    cap   [label="DIGITNOW\nUSB AV capture"];
    kiyo  [label="Razer Kiyo X\n(rover camera)"];
  }

  subgraph cluster_dart {
    label="KEDGE dart (own power, no wires to the rover)"; style=dashed;
    dbat  [label="2S 18350 pack\nBMS, power loop plug"];
    xiao  [label="XIAO ESP32S3\nWiFi AP 192.168.4.1"];
    ddrv  [label="DRV8833 #1, #2\ndeploy, kick, drills, foot"];
    vtx   [label="Caddx Ant -> Zeus VTX\n5.8 GHz"];
  }

  lipo  -> ysplit [label="14 AWG", style=bold, penwidth=2.5];
  ysplit-> f20    [label="14 AWG", style=bold, penwidth=2.5];
  ysplit-> f10    [label="18 AWG", style=bold, penwidth=1.8];
  f20   -> bts    [label="B+ B-  14 AWG", style=bold, penwidth=2.5];
  bts   -> wiper  [label="M+ M-  14 AWG", style=bold, penwidth=2.5];
  bts   -> buck   [label="2 A inline fuse\n22 AWG"];
  buck  -> drv    [label="9.0 V  22 AWG"];
  drv   -> n20    [label="AOUT1 AOUT2\n26 AWG"];
  f10   -> jet    [label="barrel pigtail\n18 AWG, centre +", style=bold, penwidth=1.8];
  f10   -> rc832  [label="1 A inline fuse\n22 AWG"];
  bts   -> div    [label="B+  26 AWG", style=dashed];

  jet   -> esp    [label="USB (power + serial)"];
  jet   -> cap    [label="USB", dir=back];
  jet   -> kiyo   [label="USB", dir=back];
  rc832 -> cap    [label="AV out (yellow RCA)"];

  esp   -> bts    [label="RPWM {PIN_RPWM}, LPWM {PIN_LPWM}\nR_EN {PIN_REN}, L_EN {PIN_LEN}, 3V3, GND", style=dashed];
  bts   -> esp    [label="IS -> GPIO {PIN_WIPER_IS}\n(1 k / 680 R)", style=dashed];
  div   -> esp    [label="GPIO {PIN_VBAT}", style=dashed];
  esp   -> drv    [label="AIN1 {PIN_DRUM_IN1}, AIN2 {PIN_DRUM_IN2}, GND", style=dashed];
  esp   -> as5600 [label="I2C SDA {PIN_SDA}, SCL {PIN_SCL}, 3V3, GND", style=dashed, dir=both];
  sw    -> esp    [label="GPIOs per WIRING.md\n(pull-up, closed = LOW)", style=dashed];
  hx    -> esp    [label="DT {PIN_HX_DT}, SCK {PIN_HX_SCK}", style=dashed];

  dbat  -> xiao   [label="5 V buck"];
  dbat  -> ddrv   [label="2S direct"];
  xiao  -> ddrv   [style=dashed];
  dbat  -> vtx    [label="5 V"];
  vtx   -> rc832  [label="5.8 GHz video", style=dotted, penwidth=1.5];
  xiao  -> jet    [label="2.4 GHz WiFi (HTTP)", style=dotted, penwidth=1.5, dir=both];
}
