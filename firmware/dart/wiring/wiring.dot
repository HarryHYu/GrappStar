"Kick N20" [label="Kick N20", fillcolor="#f2f2f2"];
"Foot N20" [label="Foot N20", fillcolor="#f2f2f2"];
"Drill motor LEFT" [label="Drill motor LEFT", fillcolor="#f2f2f2"];
"Drill motor RIGHT" [label="Drill motor RIGHT", fillcolor="#f2f2f2"];
{rank=same; "Cell 1"; "Cell 2"; "Charge socket"; "Power loop socket";} {rank=same; "Deploy N20"; "Kick N20"; "Drill motor LEFT"; "Drill motor RIGHT"; "Foot N20"; "Camera";}
