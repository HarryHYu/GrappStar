digraph G { rankdir=LR; splines=true; pad=0.4; nodesep=0.3; ranksep=1.2; bgcolor="white";
label="KEDGE dart wiring v4: DRV8833 #3 removed (its pocket stays empty). Every wire: battery unplugged."; labelloc=t; fontname="Arial"; fontsize=16;
node [shape=box, style="rounded,filled", fillcolor="#f2f2f2", fontname="Arial", fontsize=11, color="#555555"];
edge [fontname="Arial", fontsize=8, penwidth=1.4, arrowhead=none];
"Cell 1" [label="18350 cell 1", fillcolor="#f2f2f2"];
"Cell 2" [label="18350 cell 2", fillcolor="#f2f2f2"];
"Diode" [label="Schottky 1N5817 / SS14\nstripe toward the XIAO", fillcolor="#f2f2f2"];
"Cap" [label="capacitor on MP1584 OUT\nlong leg OUT+, striped leg OUT-", fillcolor="#f2f2f2"];
"XIAO" [label="XIAO ESP32S3", fillcolor="#f2f2f2"];
"DRV#1" [label="DRV8833 #1\nA = deploy, B = kick", fillcolor="#f2f2f2"];
"DRV#2" [label="DRV8833 #2\nA = both drills, B = foot", fillcolor="#ffe9c7"];
"INA219" [label="INA219 (0x40)", fillcolor="#f2f2f2"];
"BNO085" [label="BNO085 (0x4A)", fillcolor="#f2f2f2"];
